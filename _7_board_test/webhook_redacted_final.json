    {
      "parameters": {
        "jsCode": "// 거부 기준\nconst DENY_LEVEL = 10;\n\nconst body = $json.body;\nconst student = body.student;\nconst alerts = body.alerts;\n\nreturn alerts.map(alert => {\n    const level = alert.level;\n    const rule = alert.rule;\n\n    let severity;\n    let decision;\n\n    if (level >= DENY_LEVEL) {\n        severity = \"High\";\n        decision = \"deny\";\n    } else if (level >= 7) {\n        severity = \"Medium\";\n        decision = \"allow\";\n    } else {\n        severity = \"Low\";\n        decision = \"allow\";\n    }\n\n    return {\n        json: {\n            student: student,\n            src_ip: alert.ip,\n            level: level,\n            rule: rule,\n            fail_count: 0,\n            severity: severity,\n            decision: decision,\n            reason: `level ${level} (rule ${rule}) → ${decision}`\n        }\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        128
      ],
      "id": "14020dbc-77cd-46bb-957e-4b7b926df1f8",
      "name": "분류(severity)"
    },
