FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=super-secret-flask-key-change-in-production
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production

# MySQL Database connection info
# If using root user:
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/board_db?charset=utf8mb4
# Or if using created user:
# DATABASE_URL=mysql+pymysql://board_user:board_password@localhost:3306/board_db?charset=utf8mb4
